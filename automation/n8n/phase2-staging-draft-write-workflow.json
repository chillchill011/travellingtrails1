            "id": "REPLACE_WITH_DEDICATED_CREDENTIAL_ID",
            "name": "GitHub - Travelling Trails"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "return [{json:{ok:true,status:'DRAFT_CREATED_OR_EXISTS',branch:'Staging',postPath:$('Code - Decide Create or Idempotent').first().json.postPath,action:$('Code - Decide Create or Idempotent').first().json.action}}];"
        },
