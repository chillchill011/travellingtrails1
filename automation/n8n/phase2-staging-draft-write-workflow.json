      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const branch='Staging'; const p=String($json.postPath||''); const md=String($json.markdown||''); if(!/^src\\/blog\\/\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\.md$/.test(p)) throw new Error('invalid postPath'); if(!/^draft:\\s*true\\s*$/m.test(md)||/^draft:\\s*false\\s*$/m.test(md)) throw new Error('draft safety check failed'); return [{json:{...$json,branch}}];"
        },
        "id": "guard1",
        "name": "Code - Guard Staging Draft",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -380,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ 'https://api.github.com/repos/chillchill011/travellingtrails1/contents/' + $json.postPath + '?ref=Staging' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "options": {
            "response": {
              "response": {
                "neverError": true,
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "get1",
        "name": "GitHub - Check Existing Draft",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          -140,
          0
        ],
        "credentials": {
          "githubApi": {
            "id": "REPLACE_WITH_DEDICATED_CREDENTIAL_ID",
            "name": "GitHub - Travelling Trails"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const r=$json; const upstream=$('Code - Guard Staging Draft').first().json; const status=Number(r.statusCode||r.status||0); if(status===404 || (!r.sha && !r.content)) return [{json:{...upstream,action:'CREATE'}}]; if(!r.content) throw new Error('unexpected GitHub lookup response'); const existing=Buffer.from(String(r.content).replace(/\\n/g,''),'base64').toString('utf8'); if(existing===upstream.markdown) return [{json:{...upstream,action:'ALREADY_CREATED_SAME_CONTENT',existingSha:r.sha}}]; throw new Error('GitHub path collision: same path has different content');"
        },
        "id": "decide1",
        "name": "Code - Decide Create or Idempotent",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          100,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
