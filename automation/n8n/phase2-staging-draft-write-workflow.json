                "id": "c1",
                "leftValue": "={{ $json.action }}",
                "rightValue": "CREATE",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          }
        },
        "id": "if1",
        "name": "IF - Create Needed",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          340,
          0
        ]
      },
      {
        "parameters": {
          "method": "PUT",
          "url": "={{ 'https://api.github.com/repos/chillchill011/travellingtrails1/contents/' + $json.postPath }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ message: 'Create draft post: ' + $json.postPath.split('/').pop().replace('.md',''), content: $json.markdown.base64Encode(), branch: 'Staging' }) }}",
          "options": {
            "response": {
              "response": {
                "neverError": false,
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "put1",
        "name": "GitHub - Create Staging Draft",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
