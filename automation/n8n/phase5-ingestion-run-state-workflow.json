          "jsCode": "const item=$input.first();\nconst j=item.json||{};\nconst binary=item.binary||{};\nconst execId=String($execution.id||'').replace(/\\D/g,'');\nif(!execId) throw new Error('numeric execution id required for upload batch');\nconst batchId='up-'+execId;\nconst keysFor=(name)=>Object.keys(binary).filter(k=>k===name||k.startsWith(name+'_')).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));\nconst featuredKeys=keysFor('featuredPhoto');\nif(featuredKeys.length!==1) throw new Error('exactly one featured photo is required');\nconst thumbKeys=keysFor('thumbnailPhoto');\nif(thumbKeys.length>1) throw new Error('only one thumbnail photo is allowed');\nconst must=String(j.mustInclude||'').split(/\\r?\\n/).map(x=>x.trim()).filter(Boolean);\nconst trip={date:String(j.tripDate||''),author:String(j.author||'aniket'),destination:String(j.destination||''),duration:String(j.duration||''),rawNotes:String(j.rawNotes||''),routeNotes:String(j.routeNotes||''),costNotes:String(j.costNotes||''),gearNotes:String(j.gearNotes||''),mustInclude:must};\nconst specs=[];\nconst add=(key,sourceId,roles)=>{const meta=binary[key]; if(!meta) throw new Error('missing binary field '+key); specs.push({key,sourceId,roles,originalFilename:String(meta.fileName||key),mimeType:String(meta.mimeType||'')});};\nadd(featuredKeys[0],'featured-1',thumbKeys.length?['featured']:['featured','thumbnail']);\nif(thumbKeys.length) add(thumbKeys[0],'thumbnail-1',['thumbnail']);\nlet n=0; for(const key of keysFor('galleryPhotos')) add(key,`gallery-${String(++n).padStart(3,'0')}`,['gallery']);\nn=0; for(const key of keysFor('routeImages')) add(key,`route-${String(++n).padStart(3,'0')}`,['route']);\nn=0; for(const key of keysFor('unusedPhotos')) add(key,`unused-${String(++n).padStart(3,'0')}`,['unused']);\nreturn specs.map(s=>({json:{batchId,source:'form',submissionKey:String(j.submissionKey||''),trip,sourceId:s.sourceId,roles:s.roles,originalFilename:s.originalFilename,mimeType:s.mimeType},binary:{upload:binary[s.key]}}));"
        },
