        "id": "trigger1",
        "name": "Input - Processed Image Manifest",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1.1,
        "position": [-1100, 0]
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const r=String($json.runId||'').trim(); if(!r) throw new Error('runId required'); let outputs; try{outputs=JSON.parse(String($json.outputsJson||'[]'));}catch(e){throw new Error('outputsJson must be valid JSON');} if(!Array.isArray(outputs)||!outputs.length) throw new Error('outputs required'); return [{json:{runId:r,branch:'Staging',outputs}}];"
        },
        "id": "guard1",
        "name": "Code - Guard Staging Run",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-880, 0]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "https://api.github.com/repos/chillchill011/travellingtrails1/git/ref/heads/Staging",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "options": {"response":{"response":{"neverError":false,"responseFormat":"json"}}}
        },
        "id": "ref1",
        "name": "GitHub - Read Staging Ref",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [-660, 0],
        "credentials": {"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ 'https://api.github.com/repos/chillchill011/travellingtrails1/git/commits/' + $json.object.sha }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "options": {"response":{"response":{"neverError":false,"responseFormat":"json"}}}
        },
        "id": "commit1",
        "name": "GitHub - Read Base Commit",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [-440, 0],
        "credentials": {"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const input=$('Code - Guard Staging Run').first().json; const ref=$('GitHub - Read Staging Ref').first().json.object.sha; const tree=$json.tree.sha; const seen=new Set(); const out=[]; for(const o of input.outputs){ const p=String(o.repoPath||''); const pub=String(o.publicPath||''); const blob=String(o.gitBlobSha||''); const b64=String(o.contentBase64||''); if(!/^src\\/assets\\/images\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.jpg$/.test(p)||p.includes('..')) throw new Error('unsafe repoPath: '+p); const expected='/assets/images/'+p.split('/').pop(); if(pub!==expected) throw new Error('publicPath mismatch: '+p); if(!/^[a-f0-9]{40}$/.test(blob)) throw new Error('gitBlobSha required'); if(!/^[A-Za-z0-9+/]+={0,2}$/.test(b64)) throw new Error('contentBase64 required'); if(seen.has(p)) throw new Error('duplicate repoPath: '+p); seen.add(p); out.push({json:{runId:input.runId,branch:'Staging',baseRefSha:ref,baseTreeSha:tree,repoPath:p,publicPath:pub,sha256:String(o.sha256||''),gitBlobSha:blob,contentBase64:b64}}); } return out;"
        },
        "id": "split1",
        "name": "Code - Validate and Split Outputs",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-220, 0]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ 'https://api.github.com/repos/chillchill011/travellingtrails1/contents/' + $json.repoPath + '?ref=Staging' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "options": {"response":{"response":{"neverError":true,"responseFormat":"json"}}}
        },
        "id": "check1",
        "name": "GitHub - Check Existing Image",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [0, 0],
        "credentials": {"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const up=$('Code - Validate and Split Outputs').item.json; const r=$json; const status=Number(r.statusCode||r.status||0); if(status===404||(!r.sha&&!r.path)) return {json:{...up,action:'CREATE'}}; if(String(r.sha||'')===up.gitBlobSha) return {json:{...up,action:'ALREADY_EXISTS_SAME_CONTENT',blobSha:up.gitBlobSha}}; throw new Error('GitHub image collision: '+up.repoPath);"
        },
        "id": "decide1",
        "name": "Code - Decide Image Action",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [220, 0]
      },
      {
        "parameters": {
          "conditions": {"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $json.action }}","rightValue":"CREATE","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}
        },
        "id": "if1",
        "name": "IF - Blob Create Needed",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [440, 0]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.github.com/repos/chillchill011/travellingtrails1/git/blobs",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "githubApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({content:$json.contentBase64,encoding:'base64'}) }}",
          "options": {"response":{"response":{"neverError":false,"responseFormat":"json"}}}
        },
        "id": "blob1",
        "name": "GitHub - Create Image Blob",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [660, -120],
        "credentials": {"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const up=$('Code - Decide Image Action').item.json; if(String($json.sha||'')!==up.gitBlobSha) throw new Error('GitHub blob SHA mismatch for '+up.repoPath); return {json:{...up,blobSha:$json.sha,status:'UPLOADED'}};"
        },
        "id": "created1",
        "name": "Code - Verify Created Blob",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [880, -120]
      },
      {
        "parameters": {"mode":"runOnceForEachItem","jsCode":"return {json:{...$json,status:'ALREADY_EXISTS'}};"},
        "id": "same1",
        "name": "Code - Mark Existing Blob",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [660, 120]
      },
      {
        "parameters": {"mode":"append"},
        "id": "merge1",
        "name": "Merge - Blob Results",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3.2,
        "position": [1100, 0]
      },
      {
        "parameters": {
          "mode":"runOnceForAllItems",
          "jsCode":"const items=$input.all().map(x=>x.json); if(!items.length) throw new Error('no image results'); const first=items[0]; const creates=items.filter(x=>x.action==='CREATE'); if(!creates.length) return [{json:{runId:first.runId,branch:'Staging',noCommitNeeded:true,baseRefSha:first.baseRefSha,baseTreeSha:first.baseTreeSha,outputs:items.map(x=>({repoPath:x.repoPath,publicPath:x.publicPath,sha256:x.sha256,gitBlobSha:x.gitBlobSha,status:'ALREADY_EXISTS'}))}}]; return [{json:{runId:first.runId,branch:'Staging',noCommitNeeded:false,baseRefSha:first.baseRefSha,baseTreeSha:first.baseTreeSha,tree:creates.map(x=>({path:x.repoPath,mode:'100644',type:'blob',sha:x.blobSha})),outputs:items.map(x=>({repoPath:x.repoPath,publicPath:x.publicPath,sha256:x.sha256,gitBlobSha:x.gitBlobSha,status:x.status}))}}];"
        },
        "id":"agg1","name":"Code - Aggregate Atomic Tree","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,0]
      },
      {
        "parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c2","leftValue":"={{ $json.noCommitNeeded }}","rightValue":false,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"}},
        "id":"ifcommit","name":"IF - Commit Needed","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1540,0]
      },
