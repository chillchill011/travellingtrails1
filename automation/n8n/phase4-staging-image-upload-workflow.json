        "id":"tree1","name":"GitHub - Create Image Tree","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1760,-120],"credentials":{"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters":{"method":"POST","url":"https://api.github.com/repos/chillchill011/travellingtrails1/git/commits","authentication":"predefinedCredentialType","nodeCredentialType":"githubApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({message:'Phase 4 image upload: '+$('Code - Aggregate Atomic Tree').first().json.runId,tree:$json.sha,parents:[$('Code - Aggregate Atomic Tree').first().json.baseRefSha]}) }}","options":{"response":{"response":{"neverError":false,"responseFormat":"json"}}}},
        "id":"newcommit","name":"GitHub - Create Image Commit","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1980,-120],"credentials":{"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters":{"method":"PATCH","url":"https://api.github.com/repos/chillchill011/travellingtrails1/git/refs/heads/Staging","authentication":"predefinedCredentialType","nodeCredentialType":"githubApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({sha:$json.sha,force:false}) }}","options":{"response":{"response":{"neverError":false,"responseFormat":"json"}}}},
        "id":"updateref","name":"GitHub - Fast Forward Staging","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[2200,-120],"credentials":{"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters":{"method":"GET","url":"https://api.github.com/repos/chillchill011/travellingtrails1/git/ref/heads/Staging","authentication":"predefinedCredentialType","nodeCredentialType":"githubApi","options":{"response":{"response":{"neverError":false,"responseFormat":"json"}}}},
        "id":"verifyref","name":"GitHub - Verify Staging Ref","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[2420,-120],"credentials":{"githubApi":{"id":"87bhwFfIlfY4k8ko","name":"GitHub - Travelling Trails"}}
      },
      {
        "parameters":{"mode":"runOnceForAllItems","jsCode":"const planned=$('Code - Aggregate Atomic Tree').first().json; const created=$('GitHub - Create Image Commit').first().json; if($json.object.sha!==created.sha) throw new Error('Staging ref verification failed'); return [{json:{ok:true,runId:planned.runId,branch:'Staging',action:'COMMITTED',commitSha:created.sha,outputs:planned.outputs}}];"},
        "id":"done1","name":"Code - Verify Commit Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[2640,-120]
      },
      {
        "parameters":{"mode":"runOnceForAllItems","jsCode":"const p=$('Code - Aggregate Atomic Tree').first().json; return [{json:{ok:true,runId:p.runId,branch:'Staging',action:'ALREADY_EXISTS_SAME_CONTENT',commitSha:p.baseRefSha,outputs:p.outputs}}];"},
        "id":"done2","name":"Code - Idempotent Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,120]
      }
