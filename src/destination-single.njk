---
layout: base
pagination:
  data: collections.destinations
  size: 1
  alias: destination
permalink: "destinations/{{ destination.slug }}/index.html"
eleventyComputed:
  title: "{{ destination.title }} Travel Guide | Travelling Trails"
  description: "Discover {{ destination.title }} through {{ destination.count }} Travelling Trails stories, with photographs, route notes and firsthand impressions."
---
<div class="tt-destination-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Destination guide</p>
    <h1>{{ destination.title }}.</h1>
    <p>{{ destination.count }} {% if destination.count == 1 %}journey{% else %}journeys{% endif %} to help you explore {{ destination.title }} from a different perspective.</p>
  </header>
  {% if destination.posts[0] and destination.posts[0].data.featuredImage %}
    <figure class="tt-destination-page-hero">
      <img src="{{ destination.posts[0].data.featuredImage | url }}" alt="{{ destination.posts[0].data.imageAlt or destination.title }}" loading="eager" decoding="async">
    </figure>
  {% endif %}
  {% if destination.posts[0] and destination.posts[0].data.coordinates %}
  <section class="tt-section tt-destination-map-section" aria-label="Location on the map">
    <div class="tt-section-top"><div><p class="tt-eyebrow">Find your way</p><h2>On the map.</h2></div></div>
    <div id="destination-map" class="map-container loading mb-12"
      data-latitude="{{ destination.posts[0].data.coordinates.latitude }}"
      data-longitude="{{ destination.posts[0].data.coordinates.longitude }}"
      data-title="{{ destination.title }}"
      aria-label="Map of {{ destination.title }}"></div>
  </section>
  {% endif %}
  <section class="tt-section" aria-labelledby="tt-destination-adventures">
    <div class="tt-section-top"><div><p class="tt-eyebrow">Read the stories</p><h2 id="tt-destination-adventures">Adventures in {{ destination.title }}.</h2></div></div>
    <div class="tt-list-grid">
    {% for post in destination.posts %}
      {% include "components/blog-card.njk" %}
    {% endfor %}
    </div>
  </section>
</div>
<script src="{{ '/assets/js/map-handler.js' | url }}"></script>