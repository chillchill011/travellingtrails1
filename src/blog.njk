---
layout: base
title: Blog | Travelling Trails
permalink: "/blog/index.html"
---
<div class="tt-blog-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">The travel journal</p>
    <h1>Stories from the road.</h1>
    <p>Real journeys, fresh perspectives, and ideas for the next time you take the long way around.</p>
  </header>
  {% if collections.featuredPosts.length > 0 %}
  <section class="tt-section" aria-labelledby="tt-blog-featured">
    <div class="tt-section-top"><div><p class="tt-eyebrow">Start here</p><h2 id="tt-blog-featured">Editor's picks.</h2></div></div>
    <div class="tt-story-grid">
      {% for post in collections.featuredPosts | limit(3) %}{% include "components/blog-card.njk" %}{% endfor %}
    </div>
  </section>
  {% endif %}
  <section class="tt-section tt-blog-all" aria-labelledby="tt-blog-all-title">
    <div class="tt-section-top">
      <div><p class="tt-eyebrow">The archive</p><h2 id="tt-blog-all-title">All journeys.</h2></div>
    </div>
    <div class="posts-container">
      <div class="tt-story-grid">
        {% for post in collections.paginatedPosts %}
          {% set pageNum = (loop.index0 / 9) | round(0, "floor") + 1 %}
          <div class="tt-pagination-item{% if pageNum > 1 %} hidden{% endif %}" data-page="{{ pageNum }}">
            {% include "components/blog-card.njk" %}
          </div>
        {% endfor %}
      </div>
    </div>
    {% if collections.paginatedPosts.length > 9 %}
      <div class="text-center mt-12">
        <button class="load-more-btn tt-pill tt-pill-dark" type="button" data-current-page="1">Load more stories <span aria-hidden="true"><svg class="tt-arrow-icon tt-arrow-down" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></span></button>
      </div>
    {% endif %}
  </section>
  <section class="tt-newsletter" aria-labelledby="tt-blog-newsletter">
    <div class="tt-newsletter-copy">
      <p class="tt-eyebrow">Notes from the road</p>
      <h2 id="tt-blog-newsletter">Your next escape starts here.</h2>
      <p>New stories and favourite routes, shared when there's something worth telling.</p>
    </div>
    <form name="newsletter" method="POST" action="{{ '/success/' | url }}" data-netlify="true" netlify-honeypot="bot-field" class="tt-newsletter-form">
      <input type="hidden" name="form-name" value="newsletter">
      <p class="hidden"><label>Leave empty: <input name="bot-field"></label></p>
      <label class="sr-only" for="tt-blog-email">Email address</label>
      <input id="tt-blog-email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required>
      <button class="tt-pill tt-pill-dark" type="submit">Join the journey <span aria-hidden="true"><svg class="tt-arrow-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></span></button>
    </form>
  </section>
</div>
