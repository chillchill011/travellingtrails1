---
layout: base
title: Home | Travelling Trails
---

<div class="tt-home">
{% set heroPost = collections.homeFeatured[0] if collections.homeFeatured.length > 0 else collections.paginatedPosts[0] %}
<section class="tt-hero" aria-label="Discover Travelling Trails">
  {% if heroPost and (heroPost.data.featuredImage or heroPost.data.thumbnailImage) %}
  <img src="{{ (heroPost.data.featuredImage or heroPost.data.thumbnailImage) | url }}" alt="{{ heroPost.data.imageAlt or heroPost.data.title }}" fetchpriority="high">
  {% endif %}
  <div class="tt-hero-content">
    <span class="tt-kicker">The journey is the story</span>
    <h1>Find your next<br><em>beautiful detour.</em></h1>
    <p>Unhurried roads, hidden corners and stories gathered along the way. Explore real journeys from the mountains to the coast.</p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a href="{{ '/blog/' | url }}" class="tt-button">Explore the stories <span aria-hidden="true">↗</span></a>
      <a href="{{ '/about/' | url }}" class="tt-button tt-button-outline">Our story</a>
    </div>
  </div>
</section>

<section class="tt-section" aria-labelledby="featured-title">
  <div class="tt-section-heading">
    <div><span class="tt-kicker">Handpicked journeys</span><h2 id="featured-title">Stories worth the detour</h2><p class="tt-section-intro">A collection of memorable trails, quieter roads, and destinations that stayed with us.</p></div>
    <a class="tt-text-link" href="{{ '/blog/' | url }}">All stories <span aria-hidden="true">↗</span></a>
  </div>
  <div class="tt-story-grid">
  {% if collections.homeFeatured.length > 0 %}
    {% for post in collections.homeFeatured | limit(3) %}{% include "components/blog-card.njk" %}{% endfor %}
  {% else %}
    {% for post in collections.paginatedPosts | limit(3) %}{% include "components/blog-card.njk" %}{% endfor %}
  {% endif %}
  </div>
</section>

<section class="tt-stats" aria-label="Travelling Trails at a glance">
  <div class="tt-stat"><strong>{{ collections.post.length }}</strong><span>Stories shared</span></div>
  <div class="tt-stat"><strong>{{ collections.destinations.length }}</strong><span>Destinations explored</span></div>
  <div class="tt-stat"><strong>{{ collections.categories.length }}</strong><span>Ways to wander</span></div>
</section>

{% if collections.paginatedPosts.length > 0 %}
{% set spotlight = collections.paginatedPosts[0] %}
<section class="tt-section tt-featured-strip" aria-label="Latest journey">
  {% if spotlight.data.featuredImage or spotlight.data.thumbnailImage %}
  <a href="{{ spotlight.url | url }}"><img src="{{ (spotlight.data.featuredImage or spotlight.data.thumbnailImage) | url }}" alt="{{ spotlight.data.imageAlt or spotlight.data.title }}" loading="lazy"></a>
  {% endif %}
  <div class="tt-featured-copy">
    <span class="tt-kicker">From the journal</span>
    <h2>{{ spotlight.data.title }}</h2>
    <p>{{ spotlight.data.description }}</p>
    <div class="mt-7"><a class="tt-button" href="{{ spotlight.url | url }}">Read the journey <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
{% endif %}

<section class="tt-section" aria-labelledby="latest-title">
  <div class="tt-section-heading">
    <div><span class="tt-kicker">Fresh from the road</span><h2 id="latest-title">Recent adventures</h2><p class="tt-section-intro">Real experiences, useful details, and a little inspiration for the road ahead.</p></div>
    <a class="tt-text-link" href="{{ '/blog/' | url }}">Browse the journal <span aria-hidden="true">↗</span></a>
  </div>
  <div class="tt-story-grid">
    {% for post in collections.paginatedPosts | limit(6) %}{% include "components/blog-card.njk" %}{% endfor %}
  </div>
</section>

<section class="tt-newsletter" aria-labelledby="newsletter-title">
  <span class="tt-kicker">Notes from the road</span>
  <h2 id="newsletter-title">More stories. Fewer ordinary days.</h2>
  <p>Get the latest travel stories and new adventures delivered to your inbox.</p>
  <form name="newsletter" method="POST" action="/success/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="newsletter">
    <p class="hidden"><label>Do not fill this out: <input name="bot-field"></label></p>
    <label for="tt-newsletter-email" class="sr-only">Email address</label>
    <input id="tt-newsletter-email" type="email" name="email" placeholder="Your email address" autocomplete="email" required>
    <button type="submit">Join the journey →</button>
  </form>
</section>
</div>
