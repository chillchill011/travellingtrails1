---
layout: base
title: Our Team | Travelling Trails
permalink: "/team/index.html"
---
<div class="tt-team-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Behind the camera</p>
    <h1>Meet the trailblazers.</h1>
    <p>The travellers, riders, and storytellers sharing the world through Travelling Trails.</p>
  </header>
  <div class="tt-list-grid">
    {% set authorKeys = authors | getObjectKeys %}
    {% if authorKeys.length > 0 %}
      {% for slug in authorKeys %}
        {% set author = authors[slug] %}
        <article class="tt-team-card">
          <div class="tt-team-card-inner">
            <a class="tt-team-card-profile" href="{{ ('/authors/' + slug + '/') | url }}">
              {% if author.avatar %}
                <img src="{{ author.avatar | url }}" alt="{{ author.name }}" loading="lazy">
              {% else %}
                <span class="tt-team-card-avatar">{{ author.name[0] | upper }}</span>
              {% endif %}
              <div class="tt-team-card-profile-info">
                <h3>{{ author.name }}</h3>
                {% if author.role %}<span class="tt-team-card-role">{{ author.role }}</span>{% endif %}
              </div>
            </a>
            {% if author.shortBio %}
              <p class="tt-team-card-bio">{{ author.shortBio }}</p>
            {% elif author.bio %}
              <p class="tt-team-card-bio">{{ author.bio | truncate(150) }}</p>
            {% endif %}
            {% if author.social %}
            <div class="tt-team-card-links">
              {% if author.social.instagram %}<a href="{{ author.social.instagram }}" target="_blank" rel="noopener noreferrer">Instagram ↗</a>{% endif %}
              {% if author.social.twitter %}<a href="{{ author.social.twitter }}" target="_blank" rel="noopener noreferrer">Twitter ↗</a>{% endif %}
              {% if author.social.linkedin %}<a href="{{ author.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>{% endif %}
              {% if author.social.website %}<a href="{{ author.social.website }}" target="_blank" rel="noopener noreferrer">Website ↗</a>{% endif %}
            </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    {% else %}
      <p>Team information is being updated. Please check back soon.</p>
    {% endif %}
  </div>
</div>