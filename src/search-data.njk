---
permalink: /search-data.json
eleventyExcludeFromCollections: true
---
{
    "posts": [
        {%- for post in collections.post -%}
        {
            "title": {{ post.data.title | json | safe }},
            "url": {{ post.url | json | safe }},
            "description": {{ post.data.description | json | safe }},
            "categories": {% if post.data.categories %}{% if post.data.categories is string %}[{{ post.data.categories | json | safe }}]{% else %}{{ post.data.categories | json | safe }}{% endif %}{% else %}[]{% endif %},
            "author": {{ post.data.author | json | safe }},
            "date": {{ post.date | json | safe }},
            "content": {{ post.template.inputContent | striptags | json | safe }},
            "destination": {{ post.data.destination | json | safe }},
            "duration": {{ post.data.duration | json | safe }},
            "travelType": {{ post.data.travelType | json | safe }},
            "thumbnailImage": {{ post.data.thumbnailImage | json | safe }},
            "featuredImage": {{ post.data.featuredImage | json | safe }}
        }{% if not loop.last %},{% endif %}
        {%- endfor -%}
    ]
}