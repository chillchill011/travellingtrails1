---
layout: base
title: "Search Travel Stories | Travelling Trails"
permalink: /search/index.html
description: "Find Travelling Trails stories by destination or experience, from motorcycle rides and heritage visits to weekend escapes."
---
<div class="tt-search-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Find a story</p>
    <h1>Where to next?</h1>
    <p>Search real journeys, inspiring places and experiences from the Travelling Trails journal.</p>
  </header>
  <section class="tt-search-panel" aria-label="Search the journal">
    <label for="searchInput">Search stories</label>
    <div class="tt-search-field">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg>
      <input id="searchInput" type="search" placeholder="Try Kolhapur, waterfalls, motorcycle rides…" autocomplete="off" aria-describedby="searchHelp">
    </div>
    <p id="searchHelp" class="tt-search-help">Results appear below as you type. Press Enter to see the complete results.</p>
    <div class="tt-search-live" id="searchLive" hidden>
      <div class="tt-search-live-header">
        <p class="tt-search-live-summary" id="searchQuickTitle" aria-live="polite"></p>
        <button type="button" id="jumpToResults" class="tt-search-jump">
          View all results <svg class="tt-arrow-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </button>
      </div>
      <div id="searchQuickResults" class="tt-search-quick-results" aria-label="Matching story previews"></div>
    </div>
    <div class="tt-search-filters">
      <div>
        <label for="categoryFilter">Category</label>
        <select id="categoryFilter">
          <option value="">All categories</option>
          {% for category in collections.categories %}
          <option value="{{ category.title }}">{{ category.title }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label for="dateFilter">Published</label>
        <select id="dateFilter">
          <option value="">Any date</option>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="365">Last year</option>
        </select>
      </div>
      <button id="clearSearch" type="button" class="tt-search-clear">Clear filters</button>
    </div>
  </section>
  <section class="tt-search-results-section" id="allSearchResults" aria-label="Search results">
    <div class="tt-search-result-header">
      <p class="tt-eyebrow">From the journal</p>
      <h2 id="searchResultsHeading">Discover the stories</h2>
      <p id="searchStatus" role="status" aria-live="polite">Start typing or choose a category to find your next read.</p>
    </div>
    <div id="searchResults" class="tt-search-result-grid"></div>
    <div id="noResults" class="tt-search-empty hidden" role="status">No stories match these filters. Try another destination or clear the filters.</div>
  </section>
</div>