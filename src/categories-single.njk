---
layout: base
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "{% if category.slug %}categories/{{ category.slug }}/{% endif %}"
eleventyComputed:
  title: "{{ category.title }} Adventures | Travelling Trails"
  description: "Browse {{ category.count }} Travelling Trails stories about {{ category.title | lower }}, with personal experiences, photographs and travel notes."
---
<div class="tt-category-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Explore by experience</p>
    <h1>{{ category.title }}.</h1>
    <p>{{ category.count }} {% if category.count == 1 %}journey{% else %}journeys{% endif %} through the places, routes and experiences we love.</p>
  </header>
  <div class="tt-list-grid">
    {% for post in category.posts %}
      {% include "components/blog-card.njk" %}
    {% endfor %}
  </div>
</div>