---
layout: base
title: Sitemap | Travelling Trails
permalink: /sitemap/index.html
---
<div class="tt-sitemap-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Find your way</p>
    <h1>Everything, in one place.</h1>
    <p>A simple guide to the journeys, destinations and pages across Travelling Trails.</p>
  </header>

  <section class="tt-sitemap-section" aria-labelledby="tt-sitemap-pages">
    <div class="tt-sitemap-heading"><p class="tt-eyebrow">Start exploring</p><h2 id="tt-sitemap-pages">Main pages</h2></div>
    <div class="tt-sitemap-grid tt-sitemap-main-grid">
      {% set mainPages = [
        {title: "Home", path: "/", note: "The latest featured journeys"},
        {title: "Travel journal", path: "/blog/", note: "Stories from the road"},
        {title: "Explore destinations", path: "/explore/", note: "All the places we've travelled"},
        {title: "Experiences", path: "/categories/", note: "Find your kind of adventure"},
        {title: "Our story", path: "/about/", note: "Meet Travelling Trails"},
        {title: "The team", path: "/team/", note: "The people behind the journeys"},
        {title: "Search", path: "/search/", note: "Find a particular story"},
        {title: "Contact", path: "/contact/", note: "Say hello"}
      ] %}
      {% for pageLink in mainPages %}
      <a class="tt-sitemap-link" href="{{ pageLink.path | url }}">
        <span><strong>{{ pageLink.title }}</strong><small>{{ pageLink.note }}</small></span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
      </a>
      {% endfor %}
    </div>
  </section>

  {% if collections.destinations.length > 0 %}
  <section class="tt-sitemap-section" aria-labelledby="tt-sitemap-destinations">
    <div class="tt-sitemap-heading"><p class="tt-eyebrow">Where to go</p><h2 id="tt-sitemap-destinations">Destinations</h2></div>
    <div class="tt-sitemap-grid">
      {% for destination in collections.destinations %}
      <a class="tt-sitemap-link" href="{{ ('/destinations/' + destination.slug + '/') | url }}">
        <span><strong>{{ destination.title }}</strong><small>{{ destination.count }} {% if destination.count == 1 %}journey{% else %}journeys{% endif %}</small></span><svg class="tt-sitemap-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if collections.categories.length > 0 %}
  <section class="tt-sitemap-section" aria-labelledby="tt-sitemap-categories">
    <div class="tt-sitemap-heading"><p class="tt-eyebrow">What to experience</p><h2 id="tt-sitemap-categories">Experiences</h2></div>
    <div class="tt-sitemap-grid">
      {% for category in collections.categories %}
      <a class="tt-sitemap-link" href="{{ ('/categories/' + category.slug + '/') | url }}">
        <span><strong>{{ category.title }}</strong><small>{{ category.count }} {% if category.count == 1 %}story{% else %}stories{% endif %}</small></span><svg class="tt-sitemap-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="tt-sitemap-section" aria-labelledby="tt-sitemap-stories">
    <div class="tt-sitemap-heading"><p class="tt-eyebrow">The complete archive</p><h2 id="tt-sitemap-stories">Travel stories</h2></div>
    <div class="tt-sitemap-grid tt-sitemap-post-grid">
      {% for post in collections.post | reverse %}
      <a class="tt-sitemap-link" href="{{ post.url | url }}">
        <span><strong>{{ post.data.title }}</strong><small>{{ post.date | postDate }}</small></span>
        <svg class="tt-sitemap-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="tt-sitemap-section tt-sitemap-utility" aria-labelledby="tt-sitemap-more">
    <div class="tt-sitemap-heading"><p class="tt-eyebrow">Site information</p><h2 id="tt-sitemap-more">More links</h2></div>
    <div class="tt-sitemap-grid">
      <a class="tt-sitemap-link" href="{{ '/privacy-policy/' | url }}"><span><strong>Privacy policy</strong><small>How we handle your information</small></span><svg class="tt-sitemap-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></a>
      <a class="tt-sitemap-link" href="{{ '/sitemap.xml' | url }}"><span><strong>XML sitemap</strong><small>For search engines</small></span><svg class="tt-sitemap-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></a>
    </div>
  </section>
</div>