{% macro categoryCard(category) %}
<a class="tt-category-card" href="{% categoryUrl category.title %}">
  <span class="tt-category-card-arrow" aria-hidden="true"><svg class="tt-arrow-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></span>
  <h3>{{ category.title }}</h3>
  <p>{{ category.count }} {% if category.count == 1 %}story{% else %}stories{% endif %} to explore</p>
</a>
{% endmacro %}