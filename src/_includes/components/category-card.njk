{% macro categoryCard(category) %}
<a class="tt-category-card" href="{% categoryUrl category.title %}">
  <span class="tt-category-card-arrow" aria-hidden="true">↗</span>
  <h3>{{ category.title }}</h3>
  <p>{{ category.count }} {% if category.count == 1 %}story{% else %}stories{% endif %} to explore</p>
</a>
{% endmacro %}