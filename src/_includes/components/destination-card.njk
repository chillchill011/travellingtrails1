{% macro destinationCard(destination) %}
{% set postActivities = [] %}
{% for post in destination.posts %}
  {% if post.data.activities %}
    {% if post.data.activities is string %}
      {% set postActivities = (postActivities.push(post.data.activities), postActivities) %}
    {% else %}
      {% for activity in post.data.activities %}
        {% set postActivities = (postActivities.push(activity), postActivities) %}
      {% endfor %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set destinationUrl = '/destinations/' + destination.slug + '/' %}
<a class="destination-card tt-destination-collection-card" href="{{ destinationUrl | url }}"
   data-destination="{{ destination.title }}"
   data-activities="{{ postActivities | join(',') }}"
   data-date="{{ destination.posts[0].date if destination.posts[0] }}">
  <div class="tt-destination-collection-photo">
    {% if destination.posts[0] and (destination.posts[0].data.featuredImage or destination.posts[0].data.thumbnailImage) %}
    <img src="{{ (destination.posts[0].data.featuredImage or destination.posts[0].data.thumbnailImage) | url }}" alt="{{ destination.title }}" loading="lazy" decoding="async">
    {% endif %}
    <span class="tt-destination-collection-overlay"></span>
    <span class="tt-destination-collection-caption"><small>{{ destination.count }} {% if destination.count == 1 %}journey{% else %}journeys{% endif %}</small><strong>{{ destination.title }}</strong></span>
    <span class="tt-destination-collection-arrow" aria-hidden="true"><svg class="tt-arrow-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></span>
  </div>
</a>
{% endmacro %}