{% macro touristAttractionSchema(title, description, url, image, address, latitude, longitude, openingHours, priceRange) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": {{ title | json | safe }},
  "description": {{ description | json | safe }},
  "url": {{ (site.url ~ url) | json | safe }}
  {% if image %},"image": {{ (site.url ~ image) | json | safe }}{% endif %}
  {% if address %},"address": {
    "@type": "PostalAddress",
    "addressCountry": {{ address.country | json | safe }},
    "addressLocality": {{ address.locality | json | safe }},
    "addressRegion": {{ address.region | json | safe }}
  }{% endif %}
  {% if latitude and longitude %},"geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ latitude }},
    "longitude": {{ longitude }}
  }{% endif %}
  {% if openingHours %},"openingHours": {{ openingHours | json | safe }}{% endif %}
  {% if priceRange %},"priceRange": {{ priceRange | json | safe }}{% endif %}
}
</script>
{% endmacro %}

{% macro touristDestinationSchema(title, description, url, image, containsAttractions) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": {{ title | json | safe }},
  "description": {{ description | json | safe }},
  "url": {{ (site.url ~ url) | json | safe }}
  {% if image %},"image": {{ (site.url ~ image) | json | safe }}{% endif %}
  {% if containsAttractions and containsAttractions.length > 0 %},
  "containsAttraction": [
    {% for attraction in containsAttractions %}
    {
      "@type": "TouristAttraction",
      "name": {{ attraction.name | json | safe }},
      "url": {{ (site.url ~ attraction.url) | json | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]{% endif %}
}
</script>
{% endmacro %}
