<article class="blog-card tt-card">
  <a class="tt-card-image" href="{{ post.url | url }}" aria-label="Read {{ post.data.title }}">
    {% if post.data.thumbnailImage or post.data.featuredImage %}
      <img src="{{ (post.data.thumbnailImage or post.data.featuredImage) | url }}" alt="{{ post.data.thumbnailAlt or post.data.imageAlt or post.data.title }}" loading="lazy" decoding="async">
    {% else %}
      <span class="tt-card-fallback">Travelling Trails</span>
    {% endif %}
    {% if post.data.featured %}<span class="tt-card-featured">Editor's pick</span>{% endif %}
  </a>
  <div class="tt-card-content">
    <div class="tt-card-eyebrow">
      {% if post.data.categories %}
        <span>{{ post.data.categories if post.data.categories is string else post.data.categories[0] }}</span>
      {% elif post.data.destination %}
        <span>{{ post.data.destination }}</span>
      {% else %}
        <span>Travel journal</span>
      {% endif %}
      {% if post.date %}<time datetime="{{ post.date | postDate }}">{{ post.date | postDate }}</time>{% endif %}
    </div>
    <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    <a class="tt-card-read" href="{{ post.url | url }}">Read the story <span aria-hidden="true">↗</span></a>
  </div>
</article>
