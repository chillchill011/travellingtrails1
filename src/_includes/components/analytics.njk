{% macro googleAnalytics(measurementId) %}
<!-- Google Analytics 4: automatic page views and Enhanced Measurement stay owned by GA4. -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ measurementId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('js', new Date());
  // Read the existing cookie-banner choice before GA4 config is issued.
  // Consent is denied until the visitor explicitly accepts.
  var ttAnalyticsConsent = 'denied';
  try {
    ttAnalyticsConsent = localStorage.getItem('cookie-consent') === 'accepted'
      ? 'granted' : 'denied';
  } catch (error) { /* storage may be disabled */ }
  gtag('consent', 'default', {
    analytics_storage: ttAnalyticsConsent,
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied'
  });
  gtag('config', '{{ measurementId }}');
</script>
{% endmacro %}