---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {# Public entry points only. Do not include noindex utilities such as search or form success. #}
  {% set mainPaths = ["/", "/blog/", "/explore/", "/categories/", "/about/", "/team/", "/contact/", "/sitemap/", "/privacy-policy/", "/gear-guide/"] %}
  {% for entry in mainPaths %}
  <url><loc>{{ site.url }}{{ entry }}</loc></url>
  {% endfor %}

  {# Blog posts have a genuine publication or modification date, unlike a build timestamp. #}
  {% for post in collections.post %}
    {% if not post.data.excludeFromSitemap %}
  <url>
    <loc>{{ site.url }}{{ post.url | url }}</loc>
    <lastmod>{{ (post.data.lastModified or post.date) | isoDate }}</lastmod>
  </url>
    {% endif %}
  {% endfor %}

  {% for destination in collections.destinations %}
  <url><loc>{{ site.url }}/destinations/{{ destination.slug }}/</loc></url>
  {% endfor %}

  {% for category in collections.categories %}
  <url><loc>{{ site.url }}/categories/{{ category.slug }}/</loc></url>
  {% endfor %}

  {% for authorPage in collections.authorPages %}
  <url><loc>{{ site.url }}/authors/{{ authorPage.slug }}/</loc></url>
  {% endfor %}
</urlset>
