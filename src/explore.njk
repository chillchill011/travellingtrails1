---
layout: base
title: Explore Destinations | Travelling Trails
permalink: /explore/index.html
---
{% include "components/map-dependencies.njk" %}
{% from "components/destination-card.njk" import destinationCard %}
<div class="tt-explore-page">
  <header class="tt-page-header">
    <p class="tt-eyebrow">Find your next detour</p>
    <h1>Places worth exploring.</h1>
    <p>Scenic routes, memorable stops and destinations discovered along the way.</p>
  </header>

  <section class="tt-explore-filters tt-page-panel" aria-label="Filter destinations">
    <div class="tt-explore-filter-grid">
      <div class="tt-explore-search-field">
        <label for="searchInput">Search destinations</label>
        <div class="tt-search-field">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg>
          <input id="searchInput" type="search" placeholder="Search places or activities…" autocomplete="off">
        </div>
      </div>
      <div><label for="categoryFilter">Destination</label>
        <select id="categoryFilter">
          <option value="">All destinations</option>
          {% for destination in collections.destinations %}
          <option value="{{ destination.title }}">{{ destination.title }}</option>
          {% endfor %}
        </select>
      </div>
      <div><label for="activityFilter">Activity</label>
        <select id="activityFilter">
          <option value="">All activities</option>
          {% set allActivities = [] %}
          {% for post in collections.post %}
            {% if post.data.activities %}
              {% if post.data.activities is string %}
                {% if not allActivities.includes(post.data.activities) %}
                  {% set allActivities = (allActivities.push(post.data.activities), allActivities) %}
                {% endif %}
              {% else %}
                {% for activity in post.data.activities %}
                  {% if activity and not allActivities.includes(activity) %}
                    {% set allActivities = (allActivities.push(activity), allActivities) %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% for activity in allActivities | sort %}
          <option value="{{ activity }}">{{ activity }}</option>
          {% endfor %}
        </select>
      </div>
      <div><label for="dateFilter">Published</label>
        <select id="dateFilter">
          <option value="">Any date</option>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="365">Last year</option>
        </select>
      </div>
    </div>
    <div class="tt-explore-filter-actions">
      <p id="exploreCount" role="status" aria-live="polite">Browse our destination guides.</p>
      <button id="resetFilters" type="button" class="tt-search-clear">Reset filters</button>
    </div>
  </section>

  <section class="tt-explore-map-section" aria-labelledby="tt-explore-map-title">
    <div class="tt-section-top">
      <div><p class="tt-eyebrow">Find your bearings</p><h2 id="tt-explore-map-title">The map of our journeys.</h2></div>
      <div class="tt-section-aside"><p>See the places we've explored and discover where your next route might lead.</p></div>
    </div>
    <div id="destinations-map"
         class="map-container loading"
         data-destinations="{{ collections.destinations | getDestinationsMapData | dump }}"
         aria-label="Map of Travelling Trails destinations"
         style="height: 400px; width: 100%;"></div>
  </section>

  <section class="tt-explore-results-section" aria-labelledby="tt-explore-all-title">
    <div class="tt-section-top">
      <div><p class="tt-eyebrow">Browse by location</p><h2 id="tt-explore-all-title">Explore all destinations.</h2></div>
    </div>
    <div id="explorePosts" class="tt-list-grid">
      {% for destination in collections.destinations %}
        {{ destinationCard(destination) }}
      {% endfor %}
    </div>
    <div id="noResults" class="tt-search-empty hidden">No destinations matched those filters. Try a different search or reset the filters.</div>
  </section>
</div>
<script src="{{ '/assets/js/map-handler.js' | url }}"></script>
<script src="{{ '/assets/js/filter-handler.js' | url }}?v=2"></script>